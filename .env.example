# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional complete SQLAlchemy URL. Leave blank to build one from the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg://erp_builder:change-me-for-local-development@localhost:5432/erp_builder
DATABASE_URL=

# PostgreSQL (development-only placeholder values)
POSTGRES_DB=erp_builder
POSTGRES_USER=erp_builder
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://localhost:8000
